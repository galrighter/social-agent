{
  "name": "Airtable → Google Contacts Sync",
  "nodes": [
    {
      "parameters": {
        "event": "newRecord",
        "base": { "__rl": true, "value": "appOtMp0nXKLtU5Yk", "mode": "id" },
        "table": { "__rl": true, "value": "tbljmeJryHQjKX99I", "mode": "id" },
        "pollTimes": {
          "item": [{ "mode": "everyMinute" }]
        }
      },
      "id": "airtable-trigger",
      "name": "New Contact in Airtable",
      "type": "n8n-nodes-base.airtableTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "not-google-source",
              "leftValue": "={{ $json.fields['מקור'] }}",
              "rightValue": "Google",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-source",
      "name": "Filter: Not from Google",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "no-people-id",
              "leftValue": "={{ $json.fields['מזהה חיצוני'] }}",
              "rightValue": "people/",
              "operator": { "type": "string", "operation": "notContains" }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "filter-no-google-id",
      "name": "Filter: No Google ID",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// Prepare Google People API create contact body\nconst record = $input.item.json;\nconst fields = record.fields || record;\n\nconst name = fields['שם'] || '';\nconst phone = fields['טלפון'] || '';\nconst email = fields['אימייל'] || '';\nconst company = fields['לקוח'] || '';\nconst notes = fields['הערות'] || '';\n\n// Split name into given/family if possible\nconst nameParts = name.split(' ');\nconst givenName = nameParts[0] || '';\nconst familyName = nameParts.slice(1).join(' ') || '';\n\nconst body = {\n  names: [{ givenName, familyName }],\n};\n\nif (phone) {\n  body.phoneNumbers = [{ value: phone, type: 'mobile' }];\n}\n\nif (email) {\n  body.emailAddresses = [{ value: email, type: 'work' }];\n}\n\nif (company) {\n  body.organizations = [{ name: company }];\n}\n\nif (notes) {\n  body.biographies = [{ value: notes, contentType: 'TEXT_PLAIN' }];\n}\n\nreturn [{\n  json: {\n    airtableRecordId: record.id,\n    googleContactBody: body,\n  }\n}];"
      },
      "id": "prepare-google-body",
      "name": "Prepare Google Contact Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://people.googleapis.com/v1/people:createContact",
        "authentication": "oAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.googleContactBody) }}",
        "options": {}
      },
      "id": "create-google-contact",
      "name": "Create Google Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": {
        "oAuth2Api": {
          "id": "GOOGLE_OAUTH2_CREDENTIAL_ID",
          "name": "Google OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract resourceName from created Google contact\nconst googleResponse = $input.item.json;\nconst resourceName = googleResponse.resourceName || '';\nconst airtableRecordId = $('Prepare Google Contact Body').item.json.airtableRecordId;\n\nreturn [{\n  json: {\n    airtableRecordId,\n    resourceName,\n  }\n}];"
      },
      "id": "extract-resource-name",
      "name": "Extract resourceName",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "value": "appOtMp0nXKLtU5Yk", "mode": "id" },
        "table": { "__rl": true, "value": "tbljmeJryHQjKX99I", "mode": "id" },
        "id": "={{ $json.airtableRecordId }}",
        "fields": {
          "values": [
            { "fieldName": "מזהה חיצוני", "fieldValue": "={{ $json.resourceName }}" }
          ]
        },
        "options": {}
      },
      "id": "update-airtable-id",
      "name": "Update External ID in Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "New Contact in Airtable": {
      "main": [[{ "node": "Filter: Not from Google", "type": "main", "index": 0 }]]
    },
    "Filter: Not from Google": {
      "main": [
        [{ "node": "Filter: No Google ID", "type": "main", "index": 0 }],
        []
      ]
    },
    "Filter: No Google ID": {
      "main": [
        [{ "node": "Prepare Google Contact Body", "type": "main", "index": 0 }],
        []
      ]
    },
    "Prepare Google Contact Body": {
      "main": [[{ "node": "Create Google Contact", "type": "main", "index": 0 }]]
    },
    "Create Google Contact": {
      "main": [[{ "node": "Extract resourceName", "type": "main", "index": 0 }]]
    },
    "Extract resourceName": {
      "main": [[{ "node": "Update External ID in Airtable", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "rightek-contact-sync"
  },
  "tags": [
    { "name": "contacts" },
    { "name": "google" },
    { "name": "sync" }
  ]
}
