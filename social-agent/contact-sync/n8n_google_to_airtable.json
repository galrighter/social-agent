      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Google People API — Incremental sync with syncToken\n// Store syncToken in n8n static data for delta syncs\n\nconst staticData = $getWorkflowStaticData('global');\nconst syncToken = staticData.googleSyncToken || null;\n\nconst googleCredential = $credentials.googleApi;\nconst accessToken = googleCredential?.accessToken || $env.GOOGLE_ACCESS_TOKEN;\n\nlet url = 'https://people.googleapis.com/v1/people/me/connections';\nlet params = {\n  personFields: 'names,phoneNumbers,emailAddresses,organizations',\n  pageSize: 100,\n};\n\nif (syncToken) {\n  params.syncToken = syncToken;\n}\n\nlet allContacts = [];\nlet nextPageToken = null;\nlet newSyncToken = null;\n\ntry {\n  do {\n    if (nextPageToken) params.pageToken = nextPageToken;\n    \n    const queryString = Object.entries(params)\n      .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)\n      .join('&');\n    \n    const resp = await $http.request({\n      method: 'GET',\n      url: `${url}?${queryString}`,\n      headers: {\n        'Authorization': `Bearer ${accessToken}`,\n      },\n    });\n    \n    const data = typeof resp === 'string' ? JSON.parse(resp) : resp;\n    \n    if (data.connections) {\n      allContacts = allContacts.concat(data.connections);\n    }\n    \n    nextPageToken = data.nextPageToken || null;\n    newSyncToken = data.nextSyncToken || newSyncToken;\n    \n  } while (nextPageToken);\n  \n  // Save new syncToken for next run\n  if (newSyncToken) {\n    staticData.googleSyncToken = newSyncToken;\n  }\n  \n} catch (error) {\n  // If syncToken is expired (410 GONE), do full sync\n  if (error.statusCode === 410 || (error.message && error.message.includes('410'))) {\n    delete staticData.googleSyncToken;\n    // Return empty to retry on next cycle with full sync\n    return [{ json: { error: 'syncToken expired, will do full sync on next run', count: 0 } }];\n  }\n  throw error;\n}\n\nif (allContacts.length === 0) {\n  return [{ json: { message: 'No changes since last sync', count: 0 } }];\n}\n\nreturn allContacts.map(contact => ({ json: contact }));"
      },
      "id": "fetch-google-contacts",
      "name": "Fetch Google Contacts (Delta)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "credentials": {
        "googleApi": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google API"
        }
      }
    },
