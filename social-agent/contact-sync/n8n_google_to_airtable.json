    {
      "parameters": {
        "jsCode": "// Normalize Google contact data\nfunction normalizePhone(phone) {\n  if (!phone) return '';\n  let clean = phone.replace(/\\D/g, '');\n  if (clean.startsWith('972')) clean = '0' + clean.slice(3);\n  return clean;\n}\n\nconst contact = $input.item.json;\n\n// Extract primary fields\nconst name = contact.names && contact.names.length > 0\n  ? contact.names[0].displayName || ''\n  : '';\n\nconst phone = contact.phoneNumbers && contact.phoneNumbers.length > 0\n  ? normalizePhone(contact.phoneNumbers[0].value || '')\n  : '';\n\nconst email = contact.emailAddresses && contact.emailAddresses.length > 0\n  ? contact.emailAddresses[0].value || ''\n  : '';\n\nconst company = contact.organizations && contact.organizations.length > 0\n  ? contact.organizations[0].name || ''\n  : '';\n\nreturn [{\n  json: {\n    resourceName: contact.resourceName || '',\n    name,\n    phone,\n    email,\n    company,\n    phoneNormalized: phone,\n    source: 'Google',\n  }\n}];"
      },
      "id": "normalize-google",
      "name": "Normalize Google Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
